# Copy this file to minecraft.auto.tfvars (which is git-ignored) and edit it.
# Terraform loads *.auto.tfvars files automatically, and
# ../scripts/terraform-init.sh reads backup_bucket_name from it to find the
# remote state bucket.

project_id         = "your-gcp-project-id"
backup_bucket_name = "your-gcp-project-id-minecraft-backups"
